<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- build.sh sets CFBundleShortVersionString and CFBundleVersion from VERSION. -->
	<key>CFBundleDevelopmentRegion</key>
	<string>en</string>
	<key>CFBundleDocumentTypes</key>
	<array>
		<!-- Archives: Finder's Open With lists Crate, and it can be made the default app. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>Archive</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>public.bzip2-archive</string>
				<string>public.tar-bzip2-archive</string>
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
				<string>org.7-zip.7-zip-archive</string>
				<string>com.rarlab.rar-archive</string>
				<string>public.iso-image</string>
				<string>public.cpio-archive</string>
				<string>com.apple.xar-archive</string>
				<string>com.apple.installer-package-archive</string>
				<string>public.z-archive</string>
				<string>com.apple.bom-compressed-cpio</string>
				<string>com.sa.crate.split-archive-part</string>
			</array>
		</dict>
		<!-- Any file or folder, rank None: accepted when dropped on the Dock icon (to compress it)
		     without adding Crate to Open With for every file. -->
		<dict>
			<key>CFBundleTypeName</key>
			<string>File or Folder</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>None</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
	</array>
	<key>CFBundleExecutable</key>
	<string>Crate</string>
	<key>CFBundleIconFile</key>
	<string>AppIcon</string>
	<key>CFBundleIdentifier</key>
	<string>com.sa.crate</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>Crate</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>LSMinimumSystemVersion</key>
	<string>13.1</string>
	<key>NSHighResolutionCapable</key>
	<true/>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Finder ▸ right-click ▸ Services. Handled by AppDelegate (NSApp.servicesProvider).
	     NSRequiredContext, even empty, makes a service enabled by default. -->
	<key>NSServices</key>
	<array>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Compress with Crate</string>
			</dict>
			<key>NSMessage</key>
			<string>compressItems</string>
			<key>NSPortName</key>
			<string>Crate</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.item</string>
				<string>public.folder</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Open with Crate</string>
			</dict>
			<key>NSMessage</key>
			<string>openItems</string>
			<key>NSPortName</key>
			<string>Crate</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>public.bzip2-archive</string>
				<string>public.tar-bzip2-archive</string>
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
				<string>org.7-zip.7-zip-archive</string>
				<string>com.rarlab.rar-archive</string>
				<string>public.iso-image</string>
				<string>public.cpio-archive</string>
				<string>com.apple.xar-archive</string>
				<string>com.apple.installer-package-archive</string>
				<string>public.z-archive</string>
				<string>com.apple.bom-compressed-cpio</string>
				<string>com.sa.crate.split-archive-part</string>
			</array>
		</dict>
		<dict>
			<key>NSMenuItem</key>
			<dict>
				<key>default</key>
				<string>Extract Here with Crate</string>
			</dict>
			<key>NSMessage</key>
			<string>extractItems</string>
			<key>NSPortName</key>
			<string>Crate</string>
			<key>NSRequiredContext</key>
			<dict/>
			<key>NSSendFileTypes</key>
			<array>
				<string>public.zip-archive</string>
				<string>public.tar-archive</string>
				<string>org.gnu.gnu-tar-archive</string>
				<string>org.gnu.gnu-zip-archive</string>
				<string>org.gnu.gnu-zip-tar-archive</string>
				<string>public.bzip2-archive</string>
				<string>public.tar-bzip2-archive</string>
				<string>org.tukaani.xz-archive</string>
				<string>org.tukaani.tar-xz-archive</string>
				<string>org.7-zip.7-zip-archive</string>
				<string>com.rarlab.rar-archive</string>
				<string>public.iso-image</string>
				<string>public.cpio-archive</string>
				<string>com.apple.xar-archive</string>
				<string>com.apple.installer-package-archive</string>
				<string>public.z-archive</string>
				<string>com.apple.bom-compressed-cpio</string>
				<string>com.sa.crate.split-archive-part</string>
			</array>
		</dict>
	</array>
	<!-- The first volume of a split archive (name.zip.001, as 7-Zip, Keka and Crate make them): Open With, Open with
	     Crate and Extract Here with Crate. Not for Quick Look: its sandbox can read only the selected volume. -->
	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>com.sa.crate.split-archive-part</string>
			<key>UTTypeDescription</key>
			<string>Split archive (first part)</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
				<string>public.archive</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>001</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
